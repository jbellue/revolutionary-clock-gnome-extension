#!/bin/bash
# Post-checkout hook to update version-name in metadata.json for development

set -e

# post-checkout passes $3=1 for a branch checkout and $3=0 when only files
# are checked out/restored. Only rewrite version-name on branch checkouts,
# otherwise `git restore src/metadata.json` would immediately dirty it again.
[ "${3:-0}" = "1" ] || exit 0

# Determine version-name based on current git state
if [ -n "$(git symbolic-ref -q HEAD)" ]; then
    # On a branch
    BRANCH=$(git symbolic-ref -q --short HEAD)
    SHORT_HASH=$(git rev-parse --short HEAD)
    VERSION="dev-${BRANCH}-${SHORT_HASH}"
else
    # Detached HEAD
    SHORT_HASH=$(git rev-parse --short HEAD)
    VERSION="dev-${SHORT_HASH}"
fi

# Update metadata.json
METADATA="src/metadata.json"
if [ -f "$METADATA" ]; then
    jq --arg v "$VERSION" '.["version-name"] = $v' "$METADATA" > "$METADATA.tmp"
    mv "$METADATA.tmp" "$METADATA"
fi
